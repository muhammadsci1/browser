<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A browser must be able to open HTTP URLs such as localhost and LAN dev servers.
         TLS trust remains restricted to the platform trust store. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
